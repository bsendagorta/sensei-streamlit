# Copia esto en Streamlit Cloud → tu app → Settings → Secrets (NUNCA en el repositorio).

[app]
password = "elige-una-contraseña-larga"

[github]
token = "github_pat_..."          # token de grano fino: solo el repo sensei-datos, Contents: Read and write
repo = "bsendagorta/sensei-datos" # repo PRIVADO donde viven tus datos
ruta = "datos.json"

[garmin]
token = '''{"di_token": "...", "di_refresh_token": "...", "di_client_id": "..."}'''
guardar_token_renovado = true     # guarda el token renovado en sensei-datos/privado/ para que no caduque
